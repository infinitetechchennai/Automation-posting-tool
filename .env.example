# ==============================================================================
# SocialPilot AI - Environment Configuration
# ==============================================================================

# Application Environment & Publishing Mode
# APP_MODE can be 'mock' (simulated publishing) or 'real' (official platform APIs)
APP_ENV=development
APP_MODE=mock
SECRET_KEY=replace_with_secure_random_secret_at_least_32_chars

# Database Configuration
# Default PostgreSQL (for Docker Compose or local postgres):
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/socialpilot
# For local standalone development without Postgres:
DATABASE_URL=sqlite+aiosqlite:///./socialpilot.db

# Redis & Celery
REDIS_URL=redis://localhost:6379/0

# Local AI Configuration (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Optional Local Image Generation Model
IMAGE_MODEL_NAME=stabilityai/stable-diffusion-xl-base-1.0
IMAGE_GENERATION_ENABLED=false

# Media Storage
MEDIA_STORAGE_PATH=./storage/media

# Security - 32-byte URL-safe base64 key for encrypting OAuth tokens at rest
TOKEN_ENCRYPTION_KEY=replace_with_fernet_key_base64

# Meta / Facebook Graph API Credentials
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:5173/social/callback/facebook

# Instagram Graph API Credentials
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:5173/social/callback/instagram

# LinkedIn API Credentials
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:5173/social/callback/linkedin

# X (Twitter) API v2 Credentials
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://localhost:5173/social/callback/twitter

# Threads by Meta API Credentials
THREADS_CLIENT_ID=
THREADS_CLIENT_SECRET=
THREADS_REDIRECT_URI=http://localhost:5173/social/callback/threads

# YouTube Data API Credentials
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:5173/social/callback/youtube

# Pinterest API v5 Credentials
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
PINTEREST_REDIRECT_URI=http://localhost:5173/social/callback/pinterest

